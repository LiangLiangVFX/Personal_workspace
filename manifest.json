{
  "manifest_version": 3,
  "name": "个人效率工作台 & 全景书签导航 OS",
  "version": "11.1.0",
  "description": "创作者与开发者专属全景书签导航座舱、无损云端同步与 8 大纯本地效率工具箱",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_icon": "logo.png",
    "default_title": "一键启动效率工作台"
  },
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "ws"
  },
  "commands": {
    "quick-save-tab": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "一键收藏当前网页到效率工作台"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "favicon"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://wttr.in/*",
    "https://wttr.is/*",
    "https://api.microlink.io/*",
    "https://api.github.com/*",
    "https://gist.githubusercontent.com/*",
    "https://*.gstatic.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}